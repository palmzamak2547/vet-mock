{
  "name": "vetmock-research",
  "private": true,
  "version": "0.1.3",
  "description": "VetMock Research Studio: statistics workspace served on research.vetmock.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 43110 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 43111 --strictPort",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:utc": "node -e \"process.env.TZ='UTC';const r=require('child_process').spawnSync(process.execPath,['--test','tests/unit/**/*.test.mjs'],{stdio:'inherit'});process.exit(r.status??1)\"",
    "e2e": "node ../node_modules/@playwright/test/cli.js test -c playwright.config.js"
  },
  "browserslist": [
    "defaults",
    "ios >= 14",
    "android >= 7",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@stdlib/math-base-special-betainc": "0.2.3",
    "@stdlib/math-base-special-binomcoefln": "0.3.1",
    "@stdlib/math-base-special-erfc": "0.2.5",
    "@stdlib/math-base-special-gammainc": "0.3.1",
    "@stdlib/math-base-special-gammaln": "0.3.1",
    "@stdlib/stats-base-dists-beta-quantile": "0.2.3",
    "@stdlib/stats-base-dists-chisquare-quantile": "0.2.3",
    "@stdlib/stats-base-dists-f-quantile": "0.2.3",
    "@stdlib/stats-base-dists-normal-quantile": "0.3.1",
    "@stdlib/stats-base-dists-studentized-range-cdf": "0.2.3",
    "@stdlib/stats-base-dists-studentized-range-quantile": "0.2.2",
    "@stdlib/stats-base-dists-t-quantile": "0.2.3",
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-virtual": "3.14.13",
    "fflate": "0.7.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "valibot": "1.4.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3"
  }
}
