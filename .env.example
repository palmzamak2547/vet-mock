# Copy this file to ".env.local" and fill in your Supabase credentials.
# Get them at: https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY_HERE

# If you leave these empty, the app runs in single-player mode (localStorage only).
# Fill them in to enable login, groups, leaderboard, and cloud sync.

# ── Optional sign-in providers ──────────────────────────────────────────────
# Everything below is set in production but was missing from this file, so a
# local checkout renders these providers as permanently broken and it is easy
# to conclude they are dead in production too. They are not.

# LINE. Set in production. Leaving it empty here makes isLiffAvailable() return
# false and signInWithLine() throw PROVIDER_NOT_CONFIGURED — that is the local
# dev state, not the deployed one. Needs a LINE Login channel plus a LIFF app
# whose endpoint is the site URL; see the header of src/lib/line-liff.js.
# The `line-auth` Edge Function is already deployed and handles the exchange.
VITE_LINE_LIFF_ID=

# Google. Optional. When set, the official Google Identity Services button is
# rendered inline and the user never sees the raw Supabase callback URL. When
# empty, sign-in falls back to the OAuth redirect, which still works.
VITE_GOOGLE_CLIENT_ID=

# Passkeys need no env var — they are enabled per project in Supabase Auth.
# They also cannot work on http://localhost, because WebAuthn requires an
# origin under the configured relying-party ID (vetmock.vercel.app). Test
# passkeys against a deployment, not a local dev server.

# ── Study library (optional) ────────────────────────────────────────────────
# The library catalog lives in Supabase (public.library_docs) and needs no env
# var: with storage_provider='supabase' the bytes are read from the private
# "library-docs" bucket through short-lived signed URLs, and that host is
# already allowed by the CSP in vercel.json.
#
# Set this ONLY when moving documents to Cloudflare R2 (storage_provider='r2').
# R2 charges nothing for egress, so a shelf that every student downloads costs
# storage alone — but the browser will not reach a new host until you ALSO add
# it to `connect-src` in vercel.json's Content-Security-Policy, and configure
# CORS on the bucket to allow GET + Range from the site origin. Without both,
# every open fails with a CSP or CORS error rather than a useful message.
#
# Must be an absolute https origin, no trailing slash.
VITE_LIBRARY_CDN_BASE=
