# Every environment variable VetMock reads, by name. Never put a value in
# this file: values live in Vercel, Supabase secrets, GitHub Actions or a
# local .env.local (gitignored). Generated from scripts/lib/env-list.mjs by
# `node scripts/env-contract.mjs --write`; docs/ENV.md says where each is read.
# Variables the platform sets (CI, VERCEL_ENV, ...) are listed there only.

# ── Supabase ──
# required: Supabase project URL, in the browser build and the functions. Without it nothing signs in or saves to an account.
VITE_SUPABASE_URL=
# required: Supabase anon (public) key, in the browser build and the functions. Without it nothing signs in or saves to an account.
VITE_SUPABASE_ANON_KEY=
# optional: Supabase URL for functions and scripts; the functions fall back to VITE_SUPABASE_URL.
SUPABASE_URL=
# optional: Anon key for functions and the delete-account edge function; the functions fall back to VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=
# required: Service-role key (secret) for functions, the edge functions and ingest scripts. Without it feedback quotas, external connections and account deletion fail.
SUPABASE_SERVICE_ROLE_KEY=
# optional: Management API token (secret) for owner scripts (library audits, links, auth emails, provenance). Scripts only.
SUPABASE_ACCESS_TOKEN=
# required: Signs the functions' calls to the database (secret). Without it exam results, race rooms and error reports are not saved.
VETMOCK_RPC_SIGNING_KEY=

# ── Sign-in ──
# required: Google OAuth web client id (public). Without it Google's own button and One Tap do not show. A new origin must be added to the client first (origin_mismatch otherwise).
VITE_GOOGLE_CLIENT_ID=
# optional: LINE LIFF app id (public). Without it the LINE sign-in button is hidden. The LIFF endpoint must be the site URL, and line-auth needs LINE_CHANNEL_ID.
VITE_LINE_LIFF_ID=
# optional: LINE Login channel id, a secret of the line-auth edge function. Without it LINE sign-in fails.
LINE_CHANNEL_ID=

# ── Library ──
# optional: Public CDN origin of R2 library files (absolute https, no trailing slash). Without it no CDN link is built and files open through signed links. A new host also needs connect-src in vercel.json and CORS on the bucket.
VITE_LIBRARY_CDN_BASE=
# required: Cloudflare token (secret) for R2 temporary credentials; also keys library links and open tickets. Without it library files do not open.
CLOUDFLARE_API_TOKEN=
# required: Cloudflare account id of the R2 buckets. Without it library files do not open.
R2_ACCOUNT_ID=
# optional: Same account id under an older name; read when R2_ACCOUNT_ID is unset.
CF_ACCOUNT_ID=
# optional: Permanent R2 key id; when set with R2_SECRET_ACCESS_KEY it is used instead of temporary credentials.
R2_ACCESS_KEY_ID=
# optional: Permanent R2 secret (secret). See R2_ACCESS_KEY_ID.
R2_SECRET_ACCESS_KEY=
# optional: Default bucket when a row names none; default vetmock-library. Scripts read it too.
R2_BUCKET=
# optional: Signs library links and open tickets when CLOUDFLARE_API_TOKEN is unset (secret).
LIBRARY_BLOB_SECRET=
# optional: CDN origin scripts/upload-library-doc.mjs prints links under. Scripts only.
LIBRARY_CDN_BASE=
# required: The slides.vetmock.com folder of answer-evidence images. Without it the slide under an answer shows its title only.
EVIDENCE_BASE=

# ── External documents ──
# optional: Notion OAuth client id. Without it and its secret the Notion connect button stays hidden; delete-account also uses it to revoke a grant.
NOTION_OAUTH_CLIENT_ID=
# optional: Notion OAuth client secret (secret). See NOTION_OAUTH_CLIENT_ID.
NOTION_OAUTH_CLIENT_SECRET=
# optional: Google OAuth client for Drive (drive.file). Without it and its secret the Drive connect button stays hidden.
GOOGLE_OAUTH_CLIENT_ID=
# optional: Google OAuth client secret (secret). See GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_SECRET=
# optional: Google Picker developer key. Without it the Drive picker does not open.
GOOGLE_PICKER_API_KEY=
# optional: Google API key for public Docs and Sheets exports. Without it a pasted public Google document cannot be read.
GOOGLE_API_KEY=
# optional: Notion integration token (secret) for pages shared with it. Without it only connected accounts read Notion.
NOTION_TOKEN=
# optional: Signs the OAuth state of external connections (secret); falls back to a key derived from SUPABASE_SERVICE_ROLE_KEY.
EXTERNAL_OAUTH_STATE_SECRET=

# ── Rate limits ──
# required: Upstash Redis REST URL, the shared limiter. In production every limited endpoint answers unavailable without it; locally an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
# required: Upstash Redis REST token (secret). See UPSTASH_REDIS_REST_URL.
UPSTASH_REDIS_REST_TOKEN=

# ── AI ──
# required: DeepSeek key (secret), the first model of every chain. Without it and ANTHROPIC_API_KEY the AI features are off; without it alone everything runs on Anthropic. Scripts use it too.
DEEPSEEK_API_KEY=
# optional: Anthropic key (secret), the fallback model. Without it a DeepSeek outage leaves the AI with no fallback.
ANTHROPIC_API_KEY=
# optional: Overrides the primary DeepSeek model id; also the video-summary script's model.
LLM_MODEL=
# optional: Overrides the DeepSeek model for image reading.
LLM_VISION_MODEL=
# optional: Overrides the Anthropic model id. Set it when the default is retired (/app/admin says so).
AI_GRADER_MODEL=
# optional: Overrides the Anthropic model for image reading.
AI_VISION_MODEL=
# optional: VetMock AI questions a day across all students; default 2,500.
AI_CHAT_DAILY_CAP=
# optional: NCBI key for PubMed lookups in VetMock AI; without it the lower anonymous rate applies.
NCBI_API_KEY=
# optional: deepseek puts DeepSeek first for handwriting transcription; default Anthropic first.
HANDWRITING_PROVIDER=
# optional: Pins one model id for handwriting transcription.
HANDWRITING_MODEL=

# ── Voice ──
# optional: ElevenLabs key (secret) for the voice call, the agent script and recorded clips. Without it the call button says voice is unavailable.
ELEVENLABS_API_KEY=
# optional: The ElevenLabs agent the voice call opens (written by scripts/ai-voice-agent.mjs). Without it the call is unavailable.
ELEVENLABS_VOICE_AGENT_ID=
# optional: 1 closes the voice call and says so (the switch in docs/HANDOVER.md).
AI_VOICE_OFF=
# optional: ElevenLabs credits never spent by the call (the account is shared); default 50,000.
AI_VOICE_FLOOR_CREDITS=
# optional: Credits a call minute is budgeted at; default 600.
AI_VOICE_CREDITS_PER_MINUTE=
# optional: Longest call; default 300.
AI_VOICE_SESSION_SECONDS=
# optional: Calls a student a Bangkok day; default 4.
AI_VOICE_USER_SESSIONS=
# optional: Calls at once; default 4.
AI_VOICE_MAX_CONCURRENT=
# optional: Gemini key (secret) for Mochi's live voice. Without it that feature stays closed.
GEMINI_API_KEY=
# optional: 1 opens Mochi's voice to students; default closed.
MOCHI_VOICE_OPEN=
# optional: Monthly spend cap for Mochi's voice.
MOCHI_VOICE_MONTHLY_USD=
# optional: Longest Mochi voice session in minutes; default 10, at most 14.
MOCHI_VOICE_SESSION_MINUTES=
# optional: Mochi voice sessions a student a month.
MOCHI_VOICE_USER_SESSIONS=
# optional: iApp key (secret) for Thai speech and transcription. Without it Thai read-aloud uses Edge and the microphone needs Workers AI.
IAPP_API_KEY=
# optional: Cloudflare token with Workers AI (secret) for Whisper transcription. Without it and IAPP_API_KEY, browsers without Web Speech show no microphone.
CF_AI_TOKEN=
# optional: Account for Workers AI; falls back to R2_ACCOUNT_ID, then CF_ACCOUNT_ID.
CF_AI_ACCOUNT_ID=
# optional: OpenRouter key for the Gemini clip generation in scripts/tts-clips.mjs. Scripts only.
OPENROUTER_API_KEY=
# optional: Path of a local env file scripts/tts-clips.mjs reads keys from. Scripts only.
TTS_KEYS_ENV=

# ── Feedback ──
# required: Resend key (secret). Without it the feedback page cannot send mail.
RESEND_API_KEY=
# optional: Where feedback mail goes; default the owner's address.
FEEDBACK_EMAIL=
# optional: Sender of feedback mail; default onboarding@resend.dev, which reaches only the Resend account owner.
FEEDBACK_FROM=
# optional: Keys the hashed sender in feedback quotas (secret); default derived from RESEND_API_KEY.
FEEDBACK_HASH_KEY=

# ── Video ──
# optional: YouTube Data API key for /api/playlist and the channel inventory script; without it the playlist is read from the public page.
YOUTUBE_API_KEY=

# ── Video scripts ──
# optional: DeepSeek spend at which the video pipeline stops. Scripts only.
VIDEO_AI_BUDGET_CNY=
# optional: Speech model folder for scripts/video-asr.py. Scripts only.
VIDEO_ASR_MODEL=
# optional: File of video ids one registry run adds. Scripts only.
VIDEO_BATCH=
# optional: Transcript and media cache folder; default data-cache/. Scripts only.
VIDEO_CACHE_DIR=
# optional: Video data root outside the checkout. Scripts only.
VIDEO_DATA_DIR=
# optional: Lock file the media download takes. Scripts only.
VIDEO_HEAVY_LOCK=
# optional: Free disk the media download keeps; default 20. Scripts only.
VIDEO_MIN_FREE_GB=
# optional: Download rate cap in yt-dlp syntax. Scripts only.
VIDEO_RATE=
# optional: 1 lists every video, not only this batch. Scripts only.
VIDEO_REGISTRY_ALL=
# optional: Shortest stretch the player may skip, in seconds; default 20. Scripts only.
VIDEO_SKIP_MIN=

# ── Content scripts ──
# optional: Answer-evidence data root outside the checkout. Scripts only.
VMX_EVIDENCE_DATA=
# optional: DeepSeek balance the evidence build keeps; default 40. Scripts only.
VMX_EVIDENCE_FLOOR_CNY=
# optional: Evidence image folder (the grant); default read from the data root. Scripts only.
VMX_EVIDENCE_FOLDER=
# optional: Model that points at slide lines. Scripts only.
VMX_EVIDENCE_POINTER=
# optional: Model that reads those lines without the key. Scripts only.
VMX_EVIDENCE_READER=
# optional: Provenance data root outside the checkout. Scripts only.
VMX_PROVENANCE_DATA=
# optional: Access token scripts/probe-api-latency.mjs signs in with. Scripts only.
VMX_PROBE_TOKEN=
# optional: Origin the prerendered wiki and covers link to; default https://vetmock.com. Build scripts.
VETMOCK_ORIGIN=
# optional: Notes vault the instructor profile script reads. Scripts only.
VETMOCK_INSTRUCTOR_VAULT=
# optional: Contact address sent to the scholarly APIs the faculty scripts call. Scripts only.
VETMOCK_RESEARCH_CONTACT=
# optional: Consensus key for the faculty expansion script. Scripts only.
CONSENSUS_API_KEY=
# optional: Pause between faculty lookups; default 400. Scripts only.
FACULTY_THROTTLE_MS=
# optional: 1 skips the network in verify:sources. Scripts only.
VETWIKI_SOURCES_OFFLINE=
# optional: 1 is --write for scripts/backfill-wiki-hashes.mjs. Scripts only.
BACKFILL_WRITE=
# optional: 1 is --check for scripts/regen-video-meta.mjs. Scripts only.
CHECK_ONLY=

# ── Tests ──
# optional: Runs the e2e suite against another origin (test:e2e:prod uses vetmock.com).
PLAYWRIGHT_BASE_URL=
# optional: Port of the e2e server; scope it to e2e only.
PLAYWRIGHT_PORT=
# optional: Where Playwright writes results; default test-results.
PLAYWRIGHT_OUTPUT_DIR=
# optional: Where CI writes the JSON e2e report; default e2e-results.json.
PLAYWRIGHT_JSON_OUTPUT_FILE=
# optional: A Chromium binary for the VCA specs and image scripts.
PLAYWRIGHT_CHROMIUM=
# optional: CPU slowdown for the perf budget spec.
PERF_BUDGET_CPU=
# optional: 1 rewrites perf-budgets.json from a fresh measurement.
UPDATE_PERF_BUDGETS=
# optional: Path of the pglite module the SQL harnesses load.
PGLITE_MODULE=
# optional: Postgres service container the SQL harnesses use in CI.
PG_CONTAINER=
# optional: Path of the pg module the VCA community harness loads.
PG_MODULE=
# optional: Postgres socket folder for the VCA community harness.
PGHOST=
# optional: Postgres user for the VCA community harness; default postgres.
PGUSER=
# optional: Moves the local gate's e2e lock file.
VMX_GATE_LOCK=
# optional: Set to 1 by test:e2e:sweep to run the route sweep, which every other run leaves out.
VMX_ROUTE_SWEEP=
# optional: 1 is --quiet for vca/scripts/build-bank.mjs.
VCA_BUILD_QUIET=
# optional: Port of the VCA e2e server.
VCA_E2E_PORT=
# optional: Runs the Research e2e against another origin.
RESEARCH_BASE_URL=
# optional: Port of the Research e2e server.
RESEARCH_E2E_PORT=
# optional: 1 saves full-page pictures of Research's key screens.
RS_SHOTS=
# optional: Rscript binary for the native R parity run; default Rscript.
RSCRIPT=
# optional: Folder of the webR runner for R parity.
WEBR_RUNNER_DIR=
# optional: Chrome binary for Research's OG image render.
CHROME=

# ── VCA perf scripts ──
# optional: CPU slowdown for the VCA perf scripts.
CPU=
# optional: 1 measures CLS at a desk viewport.
DESK=
# optional: chromium or webkit for the VCA journeys; default chromium.
ENGINE=
# optional: 1 shows the browser while measuring.
HEADED=
# optional: 1 runs Chromium headless in the journeys.
HEADLESS=
# optional: Comma list of journeys to run.
ONLY=
# optional: Comma list of routes the journey audit opens.
PATHS=
# optional: Runs per journey; the median is kept; default 3.
RUNS=
# optional: 1 scrolls the page while measuring CLS.
SCROLL=
# optional: Comma list of themes the journey audit uses; default light,dark.
THEMES=
# optional: Viewport width for the journeys; default 390.
WIDTH=
# optional: Comma list of widths the journey audit uses.
WIDTHS=
