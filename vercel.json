{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "[ \"$VERCEL_ENV\" = production ] || exit 0; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!docs' ':!.github' ':!.claude' ':!research' ':!vca' ':!ai' ':!mobile' ':!tests' ':!playwright.config.js' ':(exclude,glob)*.md' || exit 1",
  "crons": [
    { "path": "/api/ai-chat?warm=1", "schedule": "17 3 * * *" }
  ],
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/ai-chat.js": {
      "regions": [
        "sin1"
      ]
    },
    "api/ai-transcribe.js": {
      "regions": [
        "sin1"
      ]
    },
    "api/ai-voice.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/agent-action.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/exam-result.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/fetch-external-doc.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/grade-summary.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/playlist.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/race-start.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/send-feedback.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/study-coach.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/transcribe-handwriting.js": {
      "regions": [
        "iad1"
      ]
    },
    "api/wiki-explain.js": {
      "regions": [
        "iad1"
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\"), camera=(), display-capture=(), encrypted-media=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\"), fullscreen=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\"), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(self), midi=(), payment=(), picture-in-picture=(self \"https://www.youtube.com\" \"https://www.youtube-nocookie.com\"), publickey-credentials-get=(self), screen-wake-lock=(self), sync-xhr=(self), usb=(), xr-spatial-tracking=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.line-scdn.net https://accounts.google.com/gsi/client https://apis.google.com https://www.youtube.com https://s.ytimg.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; media-src 'self' https: blob: data:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://accounts.google.com/gsi/ https://docs.google.com https://access.line.me https://liff.line.me; connect-src 'self' https://tts.vetmock.com https://vetmock-library-archive.palmzamak2547.workers.dev https://*.r2.cloudflarestorage.com https://mpovsdzdggvksmeehqfj.supabase.co wss://mpovsdzdggvksmeehqfj.supabase.co https://api.github.com https://www.googleapis.com https://i.ytimg.com https://*.line.me https://*.line-scdn.net https://accounts.google.com/gsi/ https://vitals.vercel-insights.com https://va.vercel-scripts.com wss://generativelanguage.googleapis.com; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self' https://vetmock.com; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/decodeImageFrameWorker-(.*).js",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'"
        }
      ]
    },
    {
      "source": "/assets/pdf.worker.min-(.*).mjs",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/figures/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/images/(.*)",
