      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "vetmock.vercel.app"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Google-InspectionTool|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Applebot|Linespider|line-poker|[A-Za-z0-9][Bb]ot[-/;)]|[Cc]rawler|[Ss]pider).*"
