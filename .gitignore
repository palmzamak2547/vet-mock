node_modules
# Derived from src/data/changelog.js and src/data/changelog/*.js by scripts/regen-latest-changelog.mjs
# (build, dev and the unit suite write them); one file per release keeps releases conflict-free.
src/data/latest-changelog.generated.js
src/data/changelog-releases.generated.js
dist
.DS_Store
.env
.env.local
.env.*
!.env.example
scratch/
work/
*.log
.vercel

# Cache for fetched YouTube transcripts (raw ASR captions).
# Summaries derived from these go in src/data/video-summaries.js.
data-cache/

# One-shot debug scripts (not part of build).
scripts/debug-*.mjs
# One-shot copyright-deposit screenshot capture (not part of build).
# Kept locally for re-rendering the IP deposit PDF; committing it would
# trigger an unnecessary Vercel deploy for a non-shipping file.
scripts/copyright-screenshots.mjs
OVERNIGHT-SUMMARY.md

# Local MCP config · contains secret PATs · per-machine
.mcp.json

# Transient agent artifacts (video-summary patches, DICOM scratch, etc.)
# Apply scripts read from here; the JSON patches themselves don't ship.
tmp/

# Playwright e2e smoke artifacts — produced by `npm run test:e2e`,
# not part of the build. Last-run pointer + traces + screenshots regenerate
# on every run; do NOT commit (would create noisy diffs every test).
test-results/
playwright-report/
.playwright-cli/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.ds-entry.tsx
.wiki-unverified
.y2-work/
.deck-fix/
.explain-fix/
.fig-fix/
.tags-fix/
.opt-fix/
.table-fix/
.tags5/
.y1exp/
.zcode/


# MyCourseVille dumps: Palm's own course material listings, pulled from his
# account. Not repo content — the manifest is regenerated, never committed.
.mcv/
.r2env

# Local Supabase CLI cache
supabase/.temp/

# Scratch e2e repros (see testIgnore in playwright.config.js)
tests/e2e/zz-*.spec.js

# Throwaway probe folders made by reviewers under vca/scripts
vca/scripts/_*/

# library-pages.py extract output (derived text, local only)
.library-text/

# Playwright JSON report (CI duration budget, scripts/e2e-durations.mjs)
e2e-results.json
connected-e2e.json
.library-links/

# The Android app's copy of the build (mobile/scripts/fetch-bundle.mjs writes it)
mobile/www/
