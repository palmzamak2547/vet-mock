    "lint:question-voice": "node scripts/lint-question-voice.mjs",
    "lint:answer-voice": "node scripts/lint-answer-voice.mjs",
    "lint:art": "node scripts/lint-art.mjs",
    "lint:og": "node scripts/lint-og.mjs",
    "lint:exam-scope": "node scripts/lint-exam-scope.mjs && node scripts/regen-exam-papers.mjs --check",
    "lint:provenance": "node scripts/lint-provenance.mjs",
    "regen:exam-papers": "node scripts/regen-exam-papers.mjs",
    "lint:glossary": "node scripts/lint-glossary.mjs",
