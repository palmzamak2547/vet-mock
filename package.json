{
  "name": "vet-mock-exam",
  "private": true,
  "version": "5.74.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/regen-latest-changelog.mjs",
    "build": "node scripts/regen-latest-changelog.mjs && vite build && node scripts/prerender-wiki.mjs",
    "preview": "vite preview",
    "analyze": "npx --yes vite-bundle-visualizer",
    "icons": "node scripts/generate-icons.mjs",
    "lint:questions": "node scripts/lint-questions.cjs",
    "lint:ids": "node scripts/lint-q-ids.mjs",
    "lint:dupes": "node scripts/lint-q-dupes.mjs",
    "lint:academic-safety": "node scripts/lint-academic-safety.mjs",
    "lint:curriculum": "node scripts/lint-curriculum.mjs",
    "lint:instructors": "node scripts/lint-instructors.mjs",
    "lint:registry": "node scripts/regen-bank-registry.mjs --check",
    "lint:citation-index": "node scripts/regen-citation-index.mjs --check",
    "validate:wiki": "node scripts/validate-wiki.mjs",
    "sync:wiki-unmapped": "node scripts/sync-wiki-unmapped.mjs",
    "lint:all": "npm run lint:ids && npm run lint:dupes && npm run lint:academic-safety && npm run lint:questions && npm run lint:deck-refs && npm run lint:question-standard && npm run lint:delivery && npm run lint:thai-orthography && npm run lint:empty-sections && npm run lint:registry && npm run lint:changelog-latest && npm run lint:wiki-registry && npm run lint:citation-index && npm run lint:video-meta && npm run lint:notes-registry && npm run lint:conflict-summary && npm run lint:wiki-runtime && npm run lint:curriculum && npm run lint:instructors && npm run validate:wiki && npm run lint:wiki-coverage && npm run stats:check && npm run lint:accent-tokens && npm run lint:hex-budget && npm run lint:css-tokens && npm run audit:contrast && npm run audit:contrast -- --landing && npm run audit:contrast -- --exam",
    "regen:changelog": "node scripts/regen-latest-changelog.mjs",
    "fonts:convert": "node scripts/convert-fonts.mjs",
    "lint:changelog-latest": "node scripts/regen-latest-changelog.mjs --check",
    "regen:q-counts": "node scripts/regen-q-counts.mjs",
    "regen:delivery": "node scripts/regen-question-delivery.mjs",
    "regen:registry": "node scripts/regen-bank-registry.mjs",
    "regen:video-meta": "node scripts/regen-video-meta.mjs",
    "lint:video-meta": "node scripts/regen-video-meta.mjs --check",
    "regen:wiki-registry": "node scripts/regen-vetwiki-topic-registry.mjs",
    "regen:citation-index": "node scripts/regen-citation-index.mjs",
    "regen:conflict-summary": "node scripts/regen-conflict-summary.mjs",
    "regen:wiki-runtime": "node scripts/regen-vetwiki-runtime-data.mjs",
    "fix:academic-safety": "node scripts/lint-academic-safety.mjs --apply",
    "fix:questions": "node scripts/fix-question-bias.cjs",
    "fix:length": "node scripts/fix-length-bias.cjs",
    "fetch:videos": "node scripts/fetch-video-transcripts.mjs",
    "flat:transcript": "node scripts/flatten-transcript.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "db:push": "npx drizzle-kit push:pg",
    "db:seed": "node scripts/seed-vetmock.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "node scripts/test-e2e-prod.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "stats": "node scripts/stats.mjs",
    "stats:check": "node scripts/stats.mjs --check",
    "prerender:wiki": "node scripts/prerender-wiki.mjs",
    "wiki:hashes": "node scripts/backfill-wiki-hashes.mjs --write",
    "verify:sources": "node scripts/verify-wiki-sources.mjs",
    "audit:instructors": "node scripts/audit-instructors.mjs",
    "research:instructors": "node scripts/research-instructor-profiles.mjs",
    "generate:instructors": "node scripts/generate-instructor-directory.mjs",
    "wiki:coverage": "node scripts/wiki-coverage.mjs",
    "wiki:gap": "node scripts/wiki-gap.mjs",
    "wiki:link-candidates": "node scripts/wiki-link-candidates.mjs",
    "wiki:unverified": "node scripts/wiki-unverified.mjs .wiki-unverified",
    "lint:wiki-coverage": "node scripts/lint-wiki-coverage.mjs",
    "regen:notes-registry": "node scripts/regen-notes-registry.mjs",
    "lint:notes-registry": "node scripts/regen-notes-registry.mjs --check",
    "lint:wiki-registry": "node scripts/regen-vetwiki-topic-registry.mjs --check",
    "lint:conflict-summary": "node scripts/regen-conflict-summary.mjs --check",
    "lint:wiki-runtime": "node scripts/regen-vetwiki-runtime-data.mjs --check",
    "lint:deck-refs": "node scripts/lint-deck-references.mjs",
    "lint:empty-sections": "node scripts/lint-empty-sections.mjs",
    "lint:question-standard": "node scripts/lint-question-standard.mjs --ratchet",
    "lint:delivery": "node scripts/regen-question-delivery.mjs --check",
    "prep:explain-rewrite": "node scripts/batch-narrating-explains.mjs",
    "audit:coherence": "node scripts/audit-coherence.mjs",
    "lint:thai-orthography": "node scripts/lint-thai-orthography.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "lint:hex-budget": "node scripts/lint-hex-budget.mjs",
    "lint:css-tokens": "node scripts/lint-css-tokens.mjs",
    "lint:accent-tokens": "node scripts/lint-accent-tokens.mjs"
  },
  "browserslist": [
    "defaults",
    "ios >= 14",
    "android >= 7",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@cornerstonejs/core": "4.22.13",
    "@cornerstonejs/dicom-image-loader": "4.22.13",
    "@cornerstonejs/tools": "4.22.13",
    "@line/liff": "^2.29.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "clsx": "^2.1.1",
    "dicom-parser": "1.8.21",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "msedge-tts": "^2.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^17.0.1"
  },
  "overrides": {
    "fflate": "0.7.5",
    "js-yaml": "3.15.1",
    "uuid": "11.1.1"
  }
}
