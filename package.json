    "video:progress": "node scripts/video-summary-progress.mjs",
    "lint:video-corpus": "node scripts/rebuild-video-summaries.mjs --check",
    "regen:wiki-registry": "node scripts/regen-vetwiki-topic-registry.mjs",
    "regen:citation-index": "node scripts/regen-citation-index.mjs",
    "regen:conflict-summary": "node scripts/regen-conflict-summary.mjs",
    "regen:wiki-runtime": "node scripts/regen-vetwiki-runtime-data.mjs",
    "fix:academic-safety": "node scripts/lint-academic-safety.mjs --apply",
    "fix:questions": "node scripts/fix-question-bias.cjs",
    "fix:length": "node scripts/fix-length-bias.cjs",
    "fetch:videos": "node scripts/fetch-video-transcripts.mjs",
    "flat:transcript": "node scripts/flatten-transcript.mjs",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile --workers=2 --retries=1 --forbid-only",
    "test:e2e:gl": "playwright test --project=webkit-mobile --project=firefox-desktop --workers=1 --retries=1 --forbid-only",
    "test:e2e:ci": "npm run test:e2e:chromium && npm run test:e2e:gl",
    "gate": "node scripts/gate.mjs",
    "gate:fast": "node scripts/gate.mjs --e2e-concurrent",
    "gate:data": "node scripts/gate.mjs --data-only",
    "gate:serial": "npm run lint:data && npm run test:unit && npm run test:unit:utc && npm run build && npm run lint:dist && npm run test:e2e:ci",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "node scripts/test-e2e-prod.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:unit:utc": "node -e \"process.env.TZ='UTC';const r=require('child_process').spawnSync(process.execPath,['--test','tests/unit/*.test.mjs'],{stdio:'inherit'});process.exit(r.status??1)\"",
    "test": "npm run test:unit && npm run test:e2e",
    "stats": "node scripts/stats.mjs",
    "stats:check": "node scripts/stats.mjs --check",
    "prerender:wiki": "node scripts/prerender-wiki.mjs",
    "wiki:hashes": "node scripts/backfill-wiki-hashes.mjs --write",
    "verify:sources": "node scripts/verify-wiki-sources.mjs",
    "audit:instructors": "node scripts/audit-instructors.mjs",
    "research:instructors": "node scripts/research-instructor-profiles.mjs",
    "generate:instructors": "node scripts/generate-instructor-directory.mjs",
    "wiki:coverage": "node scripts/wiki-coverage.mjs",
    "wiki:gap": "node scripts/wiki-gap.mjs",
    "wiki:link-candidates": "node scripts/wiki-link-candidates.mjs",
    "wiki:unverified": "node scripts/wiki-unverified.mjs .wiki-unverified",
    "lint:wiki-coverage": "node scripts/lint-wiki-coverage.mjs",
    "regen:notes-registry": "node scripts/regen-notes-registry.mjs",
    "lint:notes-registry": "node scripts/regen-notes-registry.mjs --check",
    "lint:wiki-registry": "node scripts/regen-vetwiki-topic-registry.mjs --check",
    "lint:conflict-summary": "node scripts/regen-conflict-summary.mjs --check",
    "lint:wiki-runtime": "node scripts/regen-vetwiki-runtime-data.mjs --check",
    "lint:deck-refs": "node scripts/lint-deck-references.mjs",
    "lint:empty-sections": "node scripts/lint-empty-sections.mjs",
    "lint:quotes": "node scripts/audit-quote-fidelity.mjs --budget",
    "lint:question-standard": "node scripts/lint-question-standard.mjs --ratchet",
    "ratchet:question-standard": "node scripts/lint-question-standard.mjs --ratchet --write",
    "lint:delivery": "node scripts/regen-question-delivery.mjs --check",
    "prep:explain-rewrite": "node scripts/batch-narrating-explains.mjs",
    "audit:coherence": "node scripts/audit-coherence.mjs",
    "lint:thai-orthography": "node scripts/lint-thai-orthography.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "lint:hex-budget": "node scripts/lint-hex-budget.mjs",
    "lint:css-tokens": "node scripts/lint-css-tokens.mjs",
    "lint:accent-tokens": "node scripts/lint-accent-tokens.mjs",
    "lint:bindings": "node scripts/lint-runtime-bindings.mjs",
    "regen:mochi": "node scripts/regen-mochi-poses.mjs",
    "lint:mochi": "node scripts/regen-mochi-poses.mjs --check",
    "prebuild": "node scripts/regen-mochi-poses.mjs",
    "lint:brackets": "node scripts/audit-bracket-inserts.mjs --budget",
    "lint:garble": "node scripts/audit-quote-garble.mjs --budget",
    "lint:shipped-quotes": "node scripts/audit-shipped-quotes.mjs --budget",
    "lint:ui-copy": "node scripts/lint-ui-copy.mjs",
    "lint:citation-moments": "node scripts/lint-citation-moments.mjs",
    "lint:source-docs": "node scripts/lint-source-docs.mjs"
  },
