{
  "name": "vetmock-vca",
  "private": true,
  "version": "1.0.0",
  "description": "VetMock VCA: practice for the veterinary competency assessment, served on vca.vetmock.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bank": "node scripts/build-bank.mjs",
    "predev": "node scripts/build-bank.mjs",
    "dev": "vite --port 43120 --strictPort",
    "prebuild": "node scripts/build-bank.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --port 43121 --strictPort",
    "pretest": "node scripts/build-bank.mjs --quiet",
    "test": "node tests/run-unit.mjs",
    "test:utc": "node scripts/build-bank.mjs --quiet && node tests/run-unit.mjs UTC",
    "e2e": "node ../node_modules/@playwright/test/cli.js test -c playwright.config.js",
    "og": "node scripts/render-og.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "browserslist": [
    "defaults",
    "ios >= 14",
    "android >= 7",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3"
  }
}
