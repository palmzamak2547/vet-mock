  "browserslist": [
    "defaults",
    "ios >= 14",
    "android >= 7",
    "not dead",
    "not op_mini all"
  ],
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@elevenlabs/client": "1.36.0",
    "@supabase/supabase-js": "^2.119.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.4.6"
  }
}
