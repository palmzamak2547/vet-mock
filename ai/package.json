{
  "name": "vetmock-ai",
  "private": true,
  "version": "0.1.0",
  "description": "VetMock AI research preview, served on ai.vetmock.com",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 43130 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 43131 --strictPort",
    "test": "node --test \"tests/unit/*.test.mjs\""
